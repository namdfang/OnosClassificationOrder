# ===== design-worker env — copy thành .env và điền giá trị thật =====
# MongoDB + RabbitMQ của hệ thống chính — dùng IP TAILSCALE (100.x.x.x), KHÔNG mở port public.
DB_URI=mongodb://user:pass@100.x.x.x:27017/onos?replicaSet=rs0&directConnection=true
RABBITMQ_URI=amqp://user:pass@100.x.x.x:5672
# PHẢI trùng RABBITMQ_MAIN_EXCHANGE bên apps/api
RABBITMQ_MAIN_EXCHANGE=onos

# Cloudflare R2 (token scope Object Read & Write riêng cho worker)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=onos-designs
# Custom domain CDN đã gắn vào bucket — không slash cuối
R2_PUBLIC_BASE=https://cdn.example.com

# Biến thể ảnh (mặc định thumb 100, preview 500)
DESIGN_THUMB_DIM=100
DESIGN_PREVIEW_DIM=500
DESIGN_MAX_DOWNLOAD_MB=300

# Số job song song (file lớn — 2-4 là hợp lý cho 4 vCPU)
WORKER_PREFETCH=3
WORKER_MAX_RETRIES=3

# Optional — notify lỗi qua bot Telegram sẵn có
TELEGRAM_BOT_TOKEN=
TELEGRAM_NOTIFICATION_CHANNEL_ID=

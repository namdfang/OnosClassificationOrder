# NODE_ENV=production
NODE_ENV=development

# Base URL cua API. Services tu noi them "/v1" (CONFIG.API_VERSION) truoc moi
# endpoint, con BE dat global prefix "api/v1" => bien nay chi den "/api",
# KHONG bao gom "/v1". De rong = deploy cung domain (request tuong doi).
VITE_API_URL=""

# Optional — chi co tac dung khi chay `vite dev`. Mo trang qua domain that
# (Cloudflare Tunnel) thi baseURL tu doi sang api-<sub>.<domain>; dat bien nay
# de tro toi hostname khac neu tunnel API cua ban khong theo quy uoc do.
# VITE_TUNNEL_API_URL=https://api-task.lcndev.online/api

# VITE_PROD=true

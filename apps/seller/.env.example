# NestJS API mà proxy server-side gọi tới (không đi qua Internet) — kết thúc ở /api/v1
API_INTERNAL_URL=http://127.0.0.1:3007/api/v1
# URL công khai của chính app này (cookie secure, link tuyệt đối)
NEXT_PUBLIC_APP_URL=http://localhost:3017
# App admin — nơi quay về khi thoát mạo danh
NEXT_PUBLIC_ADMIN_URL=http://localhost:5173

# CONG TAC CHON MOI TRUONG — file nay CHI chua NODE_ENV.
#
# `src/main.ts` nap `.env` truoc de biet NODE_ENV, roi moi nap `.env.${NODE_ENV}`
# (config that, xem `.env.development.example`).
#
# dotenv KHONG ghi de bien da ton tai, nen bat ky key nao them vao day se AM THAM
# vo hieu hoa key cung ten ben `.env.development` — sua ben do se "khong an" ma
# khong bao loi gi. Giu file nay dung 1 dong.
NODE_ENV=development

# Màn chat Zalo — engine chạy ở docker/zalo-engine (xem .env.example của nó)
ZALO_ENGINE_URL=http://127.0.0.1:4001
ZALO_ENGINE_SECRET=

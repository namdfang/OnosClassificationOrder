# Chép thành `.env` cạnh file này rồi điền. `.env` đã bị .gitignore chặn —
# KHÔNG commit khoá thật.
#
# Sinh khoá:
#   openssl rand -hex 32
ENGINE_PORT=4001
PG_PW=<random>
# Trùng y hệt ZALO_ENGINE_SECRET trong apps/api/.env.<NODE_ENV>
ZALO_ENGINE_SECRET=<openssl rand -hex 32>
# Đổi khoá này = mất toàn bộ phiên Zalo đã quét QR.
ZALO_ENCRYPTION_KEY=<openssl rand -hex 32>
# Vendor cấp, mỗi server một khoá.
ZALO_LICENSE_KEY=<license>
